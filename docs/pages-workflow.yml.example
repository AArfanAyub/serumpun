# OPTIONAL: GitHub Actions auto-deploy for the web app.
#
# The public Serumpun repo is hosted with branch-based GitHub Pages (see
# scripts/deploy-pages.mjs), because the GitHub token used to publish it only has
# `repo`, `gist` and `read:org` scopes. GitHub refuses to add or update any file
# under .github/workflows/ without the extra `workflow` scope.
#
# If your token has the `workflow` scope, copy this file to
# .github/workflows/pages.yml (the YAML below is already valid and uncommented),
# then set Pages to "GitHub Actions" with:
#
#   gh api -X POST repos/OWNER/REPO/pages -f build_type=workflow

name: Deploy Serumpun to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Check out source
        uses: actions/checkout@v4
      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Type-check, test and build
        run: |
          npm run typecheck
          npm test
          npm run build
      - name: Configure Pages
        uses: actions/configure-pages@v5
        with:
          enablement: true
      - name: Upload static site
        uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
