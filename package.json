{
  "name": "serumpun",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Serumpun - free, keyless crop recommendation and 3-season rotation decision support for smallholder farmers",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "verify:live": "vitest run tests/live-smoke.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  }
}
